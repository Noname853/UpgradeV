# Salin file ini menjadi .env, lalu isi nilainya.
# JANGAN commit .env ke git.

# ─── Database ─────────────────────────────────────────────────────────────
# Default: SQLite lokal untuk dev.
DATABASE_URL="file:./dev.db"

# Untuk produksi, pakai libSQL remote (Turso), contoh:
#   DATABASE_URL="libsql://your-db-xxxx.turso.io"
#   DATABASE_AUTH_TOKEN="eyJhbGciOi..."
DATABASE_AUTH_TOKEN=

# ─── NextAuth ─────────────────────────────────────────────────────────────
# WAJIB. Generate dengan: openssl rand -base64 32
# Pakai nilai BERBEDA antara dev dan produksi.
AUTH_SECRET=

# URL public aplikasi (dipakai NextAuth untuk callback).
NEXTAUTH_URL="http://localhost:3000"

# Set "true" saat di belakang reverse proxy (Vercel/Nginx/Cloudflare).
AUTH_TRUST_HOST=true

# ─── Pendaftaran ──────────────────────────────────────────────────────────
# Set "true" untuk MENOLAK/menutup pendaftaran akun siswa baru.
# API /api/register akan balas 403 dan halaman /register tampil "Pendaftaran ditutup".
# Kosongkan atau selain "true" = pendaftaran terbuka (default).
REGISTRASI_DITUTUP=

# ─── Rate limiting (opsional, untuk produksi multi-instance) ──────────────
# Tanpa ini, rate limiter fallback ke in-memory (hanya cocok single instance).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Seed (HANYA dipakai oleh `npm run seed` / `npm run setup`) ───────────
# Wajib di-set kalau NODE_ENV=production + ALLOW_PROD_SEED=true.
# Untuk dev boleh dikosongkan (akan pakai default "admin123" / "siswa123").
SEED_ADMIN_PASSWORD=
SEED_SISWA_PASSWORD=
# ALLOW_PROD_SEED=true   # uncomment HANYA saat sengaja seed di produksi
