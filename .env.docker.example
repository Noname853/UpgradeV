# Salin file ini menjadi .env.docker lalu isi nilainya.
#   cp .env.docker.example .env.docker
# File .env.docker TIDAK ikut ke git maupun image (di-ignore). Lihat SERVER-DEPLOY.md.

# ─── Database (SQLite lokal di dalam volume Docker) ────────────────────────
# Path ini menunjuk ke volume `db-data` yang di-mount ke /app/data.
# JANGAN diubah kecuali kamu tahu yang kamu lakukan.
DATABASE_URL=file:/app/data/prod.db
# Kosongkan untuk SQLite lokal. Isi hanya jika pakai libSQL remote (Turso).
DATABASE_AUTH_TOKEN=

# ─── NextAuth ─────────────────────────────────────────────────────────────
# WAJIB. Generate string acak: openssl rand -base64 32
AUTH_SECRET=

# URL publik aplikasi (dipakai NextAuth untuk callback). Pakai https + domainmu.
NEXTAUTH_URL=https://inventaris.contoh.sch.id

# Wajib "true" karena berada di belakang reverse proxy (Caddy/Nginx).
AUTH_TRUST_HOST=true

# ─── Seed admin awal (dipakai saat menjalankan seed pertama kali) ──────────
# Karena container migrate memakai NODE_ENV=production, seed menolak jalan
# tanpa ketiga nilai ini. Ganti password dengan yang kuat.
ALLOW_PROD_SEED=true
SEED_ADMIN_PASSWORD=ganti-password-admin-yang-kuat
SEED_SISWA_PASSWORD=ganti-password-siswa-yang-kuat

# ─── Rate limiting (opsional, untuk multi-instance) ───────────────────────
# Kosong = fallback ke memori per-instance (cukup untuk 1 container).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
